class Solution(object):
    def findAnagrams(self, s, p):
        """
        :type s: str
        :type p: str
        :rtype: List[int]
        """
        from collections import Counter

        result = []
        k = len(p)

        if len(s) < k:
            return result

        p_count = Counter(p)
        window = Counter(s[:k])

        if window == p_count:
            result.append(0)

        for i in range(k, len(s)):
            window[s[i]] += 1

            left_char = s[i - k]
            window[left_char] -= 1

            if window[left_char] == 0:
                del window[left_char]

            if window == p_count:
                result.append(i - k + 1)

        return result
